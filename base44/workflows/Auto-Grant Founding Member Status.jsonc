{
  "name": "Auto-Grant Founding Member Status",
  "description": "Automatically check and grant Founding Member status when user completes their first DailyCheckIn within 7 days of signup",
  "trigger": {
    "condition": "${ (.trigger.data.tags | index(\"daily-checkin-\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "DiaryEntry"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_grant_founding_member_status",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkFoundingMemberEligibility",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkFoundingMemberEligibility"
  }
}